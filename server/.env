# Pantheos MMORPG Server Configuration
# Copy this file to .env and update with your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mmorpg_game

# For production, create a dedicated user:
# CREATE USER 'pantheos_user'@'localhost' IDENTIFIED BY 'secure_password';
# GRANT ALL PRIVILEGES ON mmorpg_game.* TO 'pantheos_user'@'localhost';

# ============================================
# SERVER PORTS
# ============================================
PORT=3000          # REST API port
WS_PORT=9000       # WebSocket port

# ============================================
# SECURITY
# ============================================
# Generate secure keys with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

API_KEY=pantheos_dev_key_12345
JWT_SECRET=pantheos_secret_key_change_in_production

# IMPORTANT: Change these in production!

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development

# Options: development, production
# In production:
# - More strict error handling
# - Reduced logging
# - HTTPS required
